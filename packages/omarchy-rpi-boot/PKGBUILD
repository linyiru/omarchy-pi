# Prototype of the Raspberry Pi boot package omarchy-lifecycle-dispatch expects
# (docs/lifecycle-dispatch.md): the firmware boot chain of an unencrypted
# Omarchy root. Built from this tree, never published.
pkgname=omarchy-rpi-boot
pkgver=0.3.1
pkgrel=1
pkgdesc="Omarchy boot operations for the Raspberry Pi (prototype)"
arch=('aarch64')
url="https://github.com/linyiru/omarchy-pi"
license=('MIT')
depends=('linux-rpi' 'mkinitcpio' 'kernel-modules-hook' 'util-linux')

package() {
  local lib=$startdir/lib file unit
  install -Dm0644 "$lib/common.sh" "$pkgdir/usr/lib/omarchy/rpi-boot/common.sh"
  for file in "$lib"/*; do
    [[ ${file##*/} == "common.sh" ]] && continue
    install -Dm0755 "$file" "$pkgdir/usr/lib/omarchy/rpi-boot/${file##*/}"
  done

  # The trial boot of a linux-rpi upgrade.
  install -Dm0644 "$startdir/initcpio/hooks/omarchy-rpi-trial" "$pkgdir/usr/lib/initcpio/hooks/omarchy-rpi-trial"
  install -Dm0644 "$startdir/initcpio/install/omarchy-rpi-trial" "$pkgdir/usr/lib/initcpio/install/omarchy-rpi-trial"
  install -Dm0644 "$startdir/mkinitcpio/91-omarchy-rpi-trial.conf" "$pkgdir/etc/mkinitcpio.conf.d/91-omarchy-rpi-trial.conf"
  install -Dm0644 -t "$pkgdir/usr/share/libalpm/hooks" "$startdir"/libalpm/*.hook
  install -Dm0644 -t "$pkgdir/usr/lib/systemd/system" "$startdir"/systemd/*.service "$startdir"/systemd/*.timer
  install -Dm0644 "$startdir/systemd/linux-modules-cleanup.service.d/omarchy-rpi-trial.conf" \
    "$pkgdir/usr/lib/systemd/system/linux-modules-cleanup.service.d/omarchy-rpi-trial.conf"
  for unit in multi-user.target.wants/omarchy-rpi-boot-trial.service graphical.target.wants/omarchy-rpi-boot-trial-commit.service \
    timers.target.wants/omarchy-rpi-boot-trial-deadline.timer; do
    install -dm0755 "$pkgdir/usr/lib/systemd/system/${unit%/*}"
    ln -s "../${unit##*/}" "$pkgdir/usr/lib/systemd/system/$unit"
  done
}
