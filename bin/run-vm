#!/bin/bash

# Boots an image built by bin/build-image in QEMU's virt machine, to try the
# first boot without a Pi. The disk is a copy-on-write overlay, so the image
# itself stays as built; --fresh discards the overlay and starts over.
#
# The virt machine's device tree is patched to claim a Raspberry Pi 5, so
# omarchy-hw-platform reads it as raspberrypi. The Pi's U-Boot doesn't run
# here: QEMU loads the kernel and initramfs from the overlay's boot partition
# directly. Timing under TCG says nothing about a Pi, only about proportions.
#
# Usage: bin/run-vm [--fresh] <image>
#
# State goes to $OMARCHY_PI_CACHE/vm (default ~/.cache/omarchy-pi/vm): the
# overlay, serial.log and qmp.sock. The display is on VNC at 127.0.0.1:5905,
# and the guest's SSH on 127.0.0.1:2222. bin/vm-qmp drives the VM's display and
# keyboard.

set -euo pipefail

fresh=0
if [[ ${1:-} == "--fresh" ]]; then
  fresh=1
  shift
fi

if (( $# != 1 )); then
  echo "Usage: $0 [--fresh] <image>" >&2
  exit 2
fi

image=$(realpath -- "$1")
state=${OMARCHY_PI_CACHE:-$HOME/.cache/omarchy-pi}/vm
overlay=$state/disk.qcow2

mkdir -p "$state"
if (( fresh )) || [[ ! -f $overlay ]]; then
  rm -f "$overlay"
  qemu-img create -q -f qcow2 -b "$image" -F raw "$overlay"
fi

# bin/disk makes a DOS label: p1 is the boot partition at 8 MiB, 512 MiB long.
disk_id=$(sfdisk --disk-id "$image")
root=PARTUUID=${disk_id#0x}-02
boot_fat=$state/boot.fat
qemu-img convert -O raw --image-opts \
  "driver=raw,offset=8M,size=512M,file.driver=qcow2,file.file.filename=$overlay" "$boot_fat"
mcopy -o -i "$boot_fat" ::Image ::initramfs-linux.img "$state/"
rm -f "$boot_fat"

machine=(
  -machine virt -accel tcg,thread=multi -cpu cortex-a76 -smp 8 -m 8G
  -drive "if=none,id=disk,file=$overlay,format=qcow2,discard=unmap"
  -device virtio-blk-pci,drive=disk
  -netdev user,id=net,hostfwd=tcp:127.0.0.1:2222-:22 -device virtio-net-pci,netdev=net
  -device virtio-gpu-pci -device virtio-keyboard-pci -device virtio-tablet-pci
)

qemu-system-aarch64 "${machine[@]}" -machine dumpdtb="$state/virt.dtb" >/dev/null
dtc -q -I dtb -O dts "$state/virt.dtb" |
  sed '0,/compatible = "linux,dummy-virt";/s//compatible = "raspberrypi,5-model-b", "brcm,bcm2712";/' |
  dtc -q -I dts -O dtb -o "$state/pi.dtb"

exec qemu-system-aarch64 "${machine[@]}" \
  -dtb "$state/pi.dtb" -kernel "$state/Image" -initrd "$state/initramfs-linux.img" \
  -append "root=$root rootfstype=btrfs rootflags=subvol=@ rw rootwait console=ttyAMA0 console=tty0" \
  -display none -vnc 127.0.0.1:5 \
  -serial "file:$state/serial.log" \
  -qmp "unix:$state/qmp.sock,server,wait=off"
