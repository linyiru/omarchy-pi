#!/bin/bash

# Builds an Omarchy Raspberry Pi disk image from Arch Linux ARM's rpi-aarch64
# root, an Omarchy checkout and an omarchy-pkgs checkout. Runs as a user with
# sudo; on an x86_64 host the image root runs under qemu-user-static.
#
# Usage: bin/build-image <omarchy-checkout> <omarchy-pkgs-checkout> <out.img> [size]
#
# Downloads and checks go to $OMARCHY_PI_CACHE (default ~/.cache/omarchy-pi),
# packages to its pkg/, which later builds reuse.

set -euo pipefail

if (( $# < 3 )); then
  echo "Usage: $0 <omarchy-checkout> <omarchy-pkgs-checkout> <out.img> [size]" >&2
  exit 2
fi

here=$(dirname -- "$(realpath -- "$0")")
repo=$(dirname -- "$here")
omarchy=$(realpath -- "$1")
omarchy_pkgs=$(realpath -- "$2")
image=$(realpath -m -- "$3")
size=${4:-16G}
cache=${OMARCHY_PI_CACHE:-$HOME/.cache/omarchy-pi}

tarball_name=ArchLinuxARM-rpi-aarch64-latest.tar.gz
tarball_url=http://os.archlinuxarm.org/os/$tarball_name
alarm_key=68B3537F39A313B3E574D06777193F152BDBE6A6
node_dist=https://nodejs.org/dist/latest

mkdir -p "$cache"
tarball=$cache/$tarball_name
rootfs=$cache/rootfs
pkgs=$cache/pkgs
mnt=$cache/mnt
pkg_cache=$cache/pkg

log() {
  echo "==> [$(date +%T)] $*"
}

in_image() {
  sudo systemd-nspawn -q -D "$mnt" --bind-ro="$repo:/opt/omarchy-pi" \
    --bind="$pkg_cache:/var/cache/pacman/pkg" --pipe "$@"
}

# pacman under qemu-user downloads at a tenth of the host's speed, so the host's
# own pacman fetches the packages, with the image's databases and keyring.
host_pacman() {
  sudo pacman --config "$cache/pacman.conf" --arch aarch64 --root "$mnt" \
    --dbpath "$mnt/var/lib/pacman" --gpgdir "$mnt/etc/pacman.d/gnupg" \
    --cachedir "$pkg_cache" --noconfirm --noprogressbar "$@"
}

cleanup() {
  if mountpoint -q "$mnt"; then
    sudo "$here/disk" umount "$mnt" || true
  fi
}
trap cleanup EXIT

log "Arch Linux ARM root"
if [[ ! -f $tarball ]]; then
  curl -fL --retry 3 -o "$tarball.part" "$tarball_url"
  curl -fL --retry 3 -o "$tarball.sig" "$tarball_url.sig"
  mv "$tarball.part" "$tarball"
fi
export GNUPGHOME=$cache/gnupg
mkdir -p -m 0700 "$GNUPGHOME"
gpg --batch --list-keys "$alarm_key" >/dev/null 2>&1 ||
  gpg --batch --keyserver hkps://keyserver.ubuntu.com --recv-keys "$alarm_key"
gpg --batch --status-fd 1 --verify "$tarball.sig" "$tarball" 2>/dev/null | grep -q "VALIDSIG $alarm_key" || {
  echo "Error: $tarball is not signed by Arch Linux ARM ($alarm_key)" >&2
  exit 1
}

# Owner setup unpacks a bundled Node.js rather than fetching it, as on an ISO
# install, so the first boot needs no network for it.
log "Node.js"
node_sum=$(curl -fsSL --retry 3 "$node_dist/SHASUMS256.txt" | grep -E '  node-v[0-9.]+-linux-arm64\.tar\.gz$')
node_tarball=$cache/${node_sum##* }
if [[ ! -f $node_tarball ]]; then
  curl -fL --retry 3 -o "$node_tarball.part" "$node_dist/${node_sum##* }"
  mv "$node_tarball.part" "$node_tarball"
fi
(cd "$cache" && sha256sum --quiet -c <<<"$node_sum")

log "Omarchy packages"
rm -rf "$pkgs"
"$here/build-packages" "$omarchy" "$omarchy_pkgs" "$pkgs"

log "Disk"
sudo rm -rf "$rootfs"
sudo mkdir -p "$rootfs"
sudo bsdtar -xpf "$tarball" -C "$rootfs"
sudo "$here/disk" create "$image" "$size"
sudo "$here/disk" mount "$image" "$mnt"
sudo rsync -aHAX --exclude=/boot/ "$rootfs/" "$mnt/"
# FAT keeps no owners, modes or links.
sudo rsync -rt "$rootfs/boot/" "$mnt/boot/"
sudo rm -rf "$rootfs"
sudo "$here/disk" fstab "$mnt"

# The root's resolv.conf points at systemd-resolved, which doesn't run here.
# stages/30-finalize.sh puts it back.
sudo mv "$mnt/etc/resolv.conf" "$mnt/etc/resolv.conf.image"
sudo cp /etc/resolv.conf "$mnt/etc/resolv.conf"

sudo install -d "$mnt/root/pkgs"
sudo cp "$pkgs"/*.pkg.tar.zst "$mnt/root/pkgs/"
OMARCHY_PATH=$omarchy "$omarchy/bin/omarchy-pkg-defaults" raspberrypi >"$cache/rpi-pkgs.txt"
sudo cp "$cache/rpi-pkgs.txt" "$mnt/root/rpi-pkgs.txt"
mapfile -t packages <"$cache/rpi-pkgs.txt"
sudo install -d "$pkg_cache"

stage() {
  log "$1"
  local start=$SECONDS
  in_image bash "/opt/omarchy-pi/stages/$1.sh"
  echo "TIMING $1 $((SECONDS - start))s"
}

stage 10-repos

log "Downloading packages"
start=$SECONDS
# The cache sits in a home directory, which the alpm user can't enter, so the
# host downloads as root; the install stage still checks every signature.
sed -e "s|^Include = /etc/|Include = $mnt/etc/|" -e '/^DownloadUser/d' "$mnt/etc/pacman.conf" >"$cache/pacman.conf"
# Everything stages/20-install.sh's transactions install: the upgrade, its
# bootstrap set, the Pi's packages, and what the local packages depend on.
host_pacman -Suw --needed base-devel git omarchy-keyring snapper lua51 luarocks omarchy-nvim "${packages[@]}"
# --ask 4: the boot package's linux-rpi replaces linux-aarch64 and U-Boot.
host_pacman -Uw --needed --ask 4 "$pkgs"/*.pkg.tar.zst
echo "TIMING download $((SECONDS - start))s"

for name in 20-install 25-boot 30-finalize; do
  stage "$name"
done

# Where install/user/mise-work.sh looks at first boot, and factory reset
# carries it to the next owner from.
sudo install -d -m 0755 "$mnt/var/lib/omarchy/provisioning/packages"
sudo install -m 0644 "$node_tarball" "$mnt/var/lib/omarchy/provisioning/packages/"

log "Factory snapshot"
sudo "$here/disk" factory "$mnt"
sudo "$here/disk" umount "$mnt"
trap - EXIT

echo "TIMING total ${SECONDS}s"
echo "Built $image"
