#!/bin/bash

# Packs a built image the way Raspberry Pi Imager takes an OS: compressed with
# xz, and described by a manifest Imager opens (double-click it, or
# `rpi-imager --repo <manifest>`). The manifest's init_format, rpi-preseed,
# tells Imager to offer its OS customisation and write the settings as
# rpi-preseed.toml, which the image's omarchy-rpi-preseed applies at first
# boot. Imager offers only the devices a manifest lists, so it lists the two
# the image is tested on, the Raspberry Pi 5 and the Raspberry Pi 4, as
# Raspberry Pi's own manifest describes them.
#
# Usage: bin/release-image <image> <out-dir> [url-base]
#
# Without url-base the manifest points at the files in out-dir, for a local
# Imager; with it, at url-base/<name>, where they will be published.

set -euo pipefail

if (( $# < 2 || $# > 3 )); then
  echo "Usage: $0 <image> <out-dir> [url-base]" >&2
  exit 2
fi

image=$(realpath -- "$1")
out=$(realpath -m -- "$2")
url_base=${3:-}
here=$(dirname -- "$(realpath -- "$0")")
name=$(basename -- "$image" .img)
date=$(date -u +%F)

mkdir -p "$out"
compressed=$out/$name.img.xz
icon=$out/$name.png
manifest=$out/$name.rpi-imager-manifest

# Imager checks what it writes against extract_sha256, and the download
# against image_download_sha256.
extract_size=$(stat -c %s "$image")
extract_sha256=$(sha256sum "$image" | cut -d' ' -f1)
xz -T0 -6 -c "$image" >"$compressed"
download_size=$(stat -c %s "$compressed")
download_sha256=$(sha256sum "$compressed" | cut -d' ' -f1)
(cd "$out" && sha256sum "${compressed##*/}" >"${compressed##*/}.sha256")
cp "$here/../docs/icon.png" "$icon"

if [[ -n $url_base ]]; then
  url=${url_base%/}/${compressed##*/}
  icon_url=${url_base%/}/${icon##*/}
else
  url=file://$compressed
  icon_url=file://$icon
fi

jq -n \
  --arg url "$url" --arg icon "$icon_url" --arg date "$date" \
  --argjson extract_size "$extract_size" --arg extract_sha256 "$extract_sha256" \
  --argjson download_size "$download_size" --arg download_sha256 "$download_sha256" \
  '{imager: {devices: [{
    name: "Raspberry Pi 5",
    tags: ["pi5-64bit"],
    icon: "https://downloads.raspberrypi.com/imager/icons/RPi_5.png",
    description: "Raspberry Pi 5, 500 / 500+, and Compute Module 5",
    matching_type: "exclusive",
    capabilities: [],
    default: true
  }, {
    name: "Raspberry Pi 4",
    tags: ["pi4-64bit"],
    icon: "https://downloads.raspberrypi.com/imager/icons/RPi_4.png",
    description: "Raspberry Pi 4 Model B, 400, and Compute Module 4 / 4S",
    matching_type: "inclusive",
    capabilities: [],
    default: false
  }]},
  os_list: [{
    name: "Omarchy Pi (64-bit)",
    description: "Omarchy, the Hyprland desktop on Arch Linux ARM, for the Raspberry Pi 5 and 4. A prototype.",
    url: $url,
    icon: $icon,
    website: "https://github.com/linyiru/omarchy-pi",
    release_date: $date,
    extract_size: $extract_size,
    extract_sha256: $extract_sha256,
    image_download_size: $download_size,
    image_download_sha256: $download_sha256,
    devices: ["pi5-64bit", "pi4-64bit"],
    init_format: "rpi-preseed",
    architecture: "armv8",
    capabilities: []
  }]}' >"$manifest"

echo "Wrote $compressed"
echo "Wrote $manifest"
